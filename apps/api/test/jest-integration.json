{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "integration/.*\\.integration\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/jest-integration.setup.ts"
  ],
  "globalSetup": "<rootDir>/jest-integration.global-setup.js",
  "maxWorkers": 1
}
