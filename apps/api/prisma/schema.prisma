  PARTIALLY_PAID
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PREPARING
  PROCESSING
  READY_FOR_PICKING
  PICKING
  PACKING
  READY_FOR_SHIPMENT
  SHIPPED
  IN_TRANSIT
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED
  RETURN_REQUESTED
  RETURNED
  DISPUTED
  FAILED
  REFUNDED
  LOST
}

enum OrderSource {
  WEB
  MOBILE_APP
  API
  POS
}

enum OrderItemStatus {
  PENDING
