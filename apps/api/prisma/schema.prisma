generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  firstName               String
  lastName                String
  email                   String                   @unique
  phone                   String                   @unique
  phoneCode               String
  passwordHash            String
  status                  String                   @default("active")
  isEmailVerified         Boolean                  @default(false)
  isPhoneVerified         Boolean                  @default(false)
  sellerOnboardingStatus  String?
  countryId               String?
  country                 Country?                 @relation(fields: [countryId], references: [id])
  preferredCurrencyId     String?
  preferredCurrency       Currency?                @relation(fields: [preferredCurrencyId], references: [id])
  preferredLanguageId     String?
  preferredLanguage       Language?                @relation(fields: [preferredLanguageId], references: [id])
  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  verificationTokens      VerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  auditLogs               AuditLog[]
  sellerProfile           SellerProfile?
  reviewedDocuments       SellerDocument[]         @relation("DocumentReviewer")
  kycReviews              SellerKycReview[]        @relation("KycReviewer")
  storeMembers            StoreMember[]
  invitedStoreMembers     StoreMember[]            @relation("StoreMemberInviter")
  sentStoreInvitations    StoreInvitation[]        @relation("StoreInviter")
  managedWarehouses       Warehouse[]              @relation("WarehouseManager")
  inventoryMovements      InventoryMovement[]      @relation("MovementCreator")
  addresses               Address[]
  carts                   Cart[]
  couponsCreated          Coupon[]                 @relation("CouponCreator")
  couponRules             CouponRule[]
  couponRedemptions       CouponRedemption[]
  checkoutSessions        CheckoutSession[]
  orderGroups             OrderGroup[]
  orders                  Order[]
  statusChanges           OrderStatusHistory[]     @relation("StatusChanger")
  stockReservations       StockReservation[]
  wallet                  Wallet?
  paymentIntents          PaymentIntent[]
  payments                Payment[]
  escrowAccountsAsBuyer   EscrowAccount[]          @relation("BuyerEscrow")
  refunds                 Refund[]
  createdShipments        InboundShipment[]        @relation("ShipmentCreator")
  inspectedShipments      ReceivingInspection[]    @relation("ShipmentInspector")
  changedReceivingHistory ReceivingHistory[]       @relation("ShipmentHistoryChanger")
  requestedTransfers      TransferOrder[]          @relation("TransferRequester")
  approvedTransfers       TransferOrder[]          @relation("TransferApprover")
  changedTransferHistory  TransferHistory[]        @relation("TransferHistoryChanger")
  warehouseMovementsMover WarehouseMovement[]      @relation("MovementMover")
  assignedCycleCounts     CycleCount[]             @relation("CycleCountAuditor")
  pickingOrdersAssigned   PickingOrder[]           @relation("PickingOperator")
  pickingBatchesAssigned  PickingBatch[]           @relation("BatchOperator")
  pickingHistories        PickingHistory[]         @relation("PickingHistoryChanger")
  pickingItemsPicked      PickingItem[]            @relation("PickingItemPicker")
  packingOrdersAssigned   PackingOrder[]           @relation("PackingOperator")
  packingHistories        PackingHistory[]         @relation("PackingHistoryChanger")
  manifestsCreated        ShippingManifest[]       @relation("ManifestCreator")
  shipmentHistories       ShipmentHistory[]        @relation("ShipmentHistoryChanger")
  labelPrintHistories     ShippingLabelHistory[]   @relation("LabelPrinter")
  trackingStatusChanges   TrackingStatusHistory[]  @relation("TrackingStatusChanger")
  pickupHistories         PickupHistory[]          @relation("PickupHistoryChanger")
  deliveryHistories       DeliveryHistory[]        @relation("DeliveryHistoryChanger")
  podDeliveries           ProofOfDelivery[]        @relation("PODDeliverer")
  podHistories            ProofOfDeliveryHistory[] @relation("PODHistoryActor")
  driverProfile           LogisticsDriver?
  routeHistories          DeliveryRouteHistory[]   @relation("RouteHistoryChanger")
  reportedExceptions      LogisticsException[]     @relation("ExceptionReporter")
  assignedExceptions      LogisticsException[]     @relation("ExceptionAssignee")
  tempPodUploads          TemporaryPodUpload[]     @relation("TempPodUploader")
  orderTimelineEvents     OrderTimeline[]          @relation("OrderTimelineActor")
  orderComments           OrderComment[]           @relation("OrderCommentAuthor")
  orderAttachments        OrderAttachment[]        @relation("OrderAttachmentUploader")
  returnRequestsAsBuyer   ReturnRequest[]          @relation("ReturnBuyer")
  returnHistoryChanges    ReturnHistory[]          @relation("ReturnHistoryChanger")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Country {
  id                      String                 @id @default(uuid())
  code                    String                 @unique
  name                    String
  flag                    String
  phonePrefix             String
  defaultCurrencyId       String?
  defaultCurrency         Currency?              @relation(fields: [defaultCurrencyId], references: [id])
  supportedLanguages      CountryLanguage[]
  users                   User[]
  sellerProfiles          SellerProfile[]
  stores                  Store[]
  brands                  Brand[]
  originProducts          Product[]              @relation("CountryOfOrigin")
  warehouses              Warehouse[]
  addresses               Address[]
  originRates             ShippingRateRule[]     @relation("OriginRate")
  destinationRates        ShippingRateRule[]     @relation("DestinationRate")
  couponRules             CouponRule[]
  carriers                Carrier[]
  carrierAccounts         CarrierAccount[]
  zoneOriginCountries     CarrierServiceZone[]   @relation("ZoneOriginCountry")
  zoneDestCountries       CarrierServiceZone[]   @relation("ZoneDestCountry")
  trackingOriginCountries Tracking[]             @relation("TrackingOriginCountry")
  trackingDestCountries   Tracking[]             @relation("TrackingDestCountry")
  trackingEvents          TrackingEvent[]
  trackingCheckpoints     TrackingCheckpoint[]
  logisticsDrivers        LogisticsDriver[]
  orderAddressSnapshots   OrderAddressSnapshot[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@map("countries")
}

model Currency {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  symbol              String
  decimals            Int                  @default(2)
  defaultInCountries  Country[]
  users               User[]
  ratesFrom           ExchangeRate[]       @relation("FromCurrency")
  ratesTo             ExchangeRate[]       @relation("ToCurrency")
  productVariants     ProductVariant[]
  carts               Cart[]
  cartItems           CartItem[]
  coupons             Coupon[]
  couponRedemptions   CouponRedemption[]
  shippingRateRules   ShippingRateRule[]
  checkoutSessions    CheckoutSession[]
  orderGroups         OrderGroup[]
  orders              Order[]
  orderItems          OrderItem[]
  paymentIntents      PaymentIntent[]
  payments            Payment[]
  wallets             Wallet[]
  ledgerEntries       LedgerEntry[]
  escrowAccounts      EscrowAccount[]
  payouts             Payout[]
  refunds             Refund[]
  warehousesAsPrimary Warehouse[]          @relation("WarehousePrimaryCurrency")
  orderPriceSnapshots OrderPriceSnapshot[]
  orderTaxes          OrderTax[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("currencies")
}

model Language {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  countries CountryLanguage[]
  users     User[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("languages")
}

model CountryLanguage {
  countryId  String
  languageId String
  country    Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([countryId, languageId])
  @@map("country_languages")
}

model ExchangeRate {
  id             String   @id @default(uuid())
  fromCurrencyId String
  fromCurrency   Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrencyId   String
  toCurrency     Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  rate           Decimal  @db.Decimal(18, 6)
  effectiveAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("exchange_rates")
}

model Session {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String?
  ipAddress     String?
  userAgent     String?
  country       String?
  lastActiveAt  DateTime       @default(now())
  isRevoked     Boolean        @default(false)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())

  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  deviceId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model VerificationToken {
  id          String    @id @default(uuid())
  challengeId String    @unique @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  tokenHash   String
  attempts    Int       @default(0)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  method    String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  entity        String?
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  country       String?
  requestId     String?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}

// ==========================================
// SPRINT 2 ENUMS & MODELS
// ==========================================

enum SellerType {
  INDIVIDUAL
  SOLE_PROPRIETOR
  COMPANY
  OFFICIAL_BRAND
  INTERNATIONAL
}

enum SellerStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  BLOCKED
}

enum SellerOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  DOCUMENTS_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  IDENTITY_DOCUMENT
  PASSPORT
  SELFIE
  ADDRESS_PROOF
  BUSINESS_REGISTRATION
  TAX_DOCUMENT
  OWNER_IDENTITY_DOCUMENT
  BANK_PROOF
  TRADEMARK_REGISTRATION
  BRAND_AUTHORIZATION
  OTHER
}

enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum StoreStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum StoreMemberRole {
  OWNER
  MANAGER
  CUSTOMER_SERVICE
  ORDER_OPERATOR
  INVENTORY_MANAGER
  FINANCE
  MARKETING
}

enum StoreMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BrandStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum SaleScope {
  NATIONAL
  INTERNATIONAL
  BOTH
}

enum SaleType {
  RETAIL
  WHOLESALE
  BOTH
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  OUT_OF_STOCK
  ARCHIVED
  SUSPENDED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum WarehouseType {
  NUSALI_HUB
  SELLER_WAREHOUSE
  TRANSIT_HUB
  PARTNER_WAREHOUSE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  CLOSED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  RETURN
}

model SellerProfile {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerType         SellerType             @default(INDIVIDUAL)
  legalName          String
  tradeName          String?
  taxId              String?
  registrationNumber String?
  status             SellerStatus           @default(PENDING)
  verificationLevel  Int                    @default(1)
  onboardingStatus   SellerOnboardingStatus @default(IN_PROGRESS)
  countryId          String
  country            Country                @relation(fields: [countryId], references: [id])
  businessEmail      String?
  businessPhone      String?
  website            String?
  description        String?
  averageRating      Decimal                @default(0) @db.Decimal(3, 2)
  totalReviews       Int                    @default(0)
  totalSales         Int                    @default(0)
  documents          SellerDocument[]
  kycReviews         SellerKycReview[]
  kycEvents          SellerKycEvent[]
  stores             Store[]
  warehouses         Warehouse[]
  coupons            Coupon[]
  orders             Order[]
  escrowAccounts     EscrowAccount[]
  payouts            Payout[]
  returnRequests     ReturnRequest[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  @@map("seller_profiles")
}

model SellerDocument {
  id              String         @id @default(uuid())
  sellerId        String
  seller          SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documentType    DocumentType
  fileKey         String
  bucket          String
  fileName        String
  mimeType        String
  fileSize        Int
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  expiresAt       DateTime?
  isCurrent       Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@map("seller_documents")
}

model SellerKycReview {
  id         String        @id @default(uuid())
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User          @relation("KycReviewer", fields: [reviewerId], references: [id])
  decision   String // APPROVED, REJECTED, NEEDS_INFO
  notes      String?
  createdAt  DateTime      @default(now())

  @@map("seller_kyc_reviews")
}

model SellerKycEvent {
  id          String        @id @default(uuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  eventType   String
  description String
  metadata    Json?
  createdAt   DateTime      @default(now())

  @@map("seller_kyc_events")
}

model Store {
  id                String             @id @default(uuid())
  sellerId          String
  seller            SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  countryId         String
  country           Country            @relation(fields: [countryId], references: [id])
  name              String
  slug              String             @unique
  description       String?
  logoKey           String?
  bannerKey         String?
  businessEmail     String?
  businessPhone     String?
  website           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  region            String?
  postalCode        String?
  latitude          Decimal?           @db.Decimal(10, 8)
  longitude         Decimal?           @db.Decimal(11, 8)
  timezone          String             @default("UTC")
  status            StoreStatus        @default(DRAFT)
  isOfficial        Boolean            @default(false)
  averageRating     Decimal            @default(0) @db.Decimal(3, 2)
  totalReviews      Int                @default(0)
  totalFollowers    Int                @default(0)
  members           StoreMember[]
  invitations       StoreInvitation[]
  products          Product[]
  cartItems         CartItem[]
  coupons           Coupon[]
  shippingRateRules ShippingRateRule[]
  orders            Order[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@map("stores")
}

model StoreMember {
  id          String            @id @default(uuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        StoreMemberRole   @default(MANAGER)
  status      StoreMemberStatus @default(ACTIVE)
  invitedById String?
  invitedBy   User?             @relation("StoreMemberInviter", fields: [invitedById], references: [id])
  joinedAt    DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([storeId, userId])
  @@map("store_members")
}

model StoreInvitation {
  id          String          @id @default(uuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email       String
  role        StoreMemberRole @default(MANAGER)
  tokenHash   String          @unique
  invitedById String
  invitedBy   User            @relation("StoreInviter", fields: [invitedById], references: [id])
  status      String          @default("PENDING")
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("store_invitations")
}

model Category {
  id          String         @id @default(uuid())
  parentId    String?
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryHierarchy")
  name        String
  slug        String         @unique
  description String?
  iconKey     String?
  imageKey    String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  products    Product[]
  couponRules CouponRule[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@map("categories")
}

model Brand {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  logoKey     String?
  countryId   String?
  country     Country?    @relation(fields: [countryId], references: [id])
  isVerified  Boolean     @default(false)
  status      BrandStatus @default(ACTIVE)
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@map("brands")
}

model Product {
  id                String           @id @default(uuid())
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?           @relation(fields: [brandId], references: [id])
  title             String
  slug              String           @unique
  description       String
  condition         ProductCondition @default(NEW)
  productType       ProductType      @default(PHYSICAL)
  saleScope         SaleScope        @default(BOTH)
  saleType          SaleType         @default(RETAIL)
  status            ProductStatus    @default(DRAFT)
  countryOfOriginId String?
  countryOfOrigin   Country?         @relation("CountryOfOrigin", fields: [countryOfOriginId], references: [id])
  weight            Decimal?         @db.Decimal(8, 3)
  length            Decimal?         @db.Decimal(8, 2)
  width             Decimal?         @db.Decimal(8, 2)
  height            Decimal?         @db.Decimal(8, 2)
  warrantyDays      Int              @default(0)
  returnPolicy      String?
  averageRating     Decimal          @default(0) @db.Decimal(3, 2)
  totalReviews      Int              @default(0)
  totalSales        Int              @default(0)
  viewCount         Int              @default(0)
  images            ProductImage[]
  variants          ProductVariant[]
  cartItems         CartItem[]
  couponRules       CouponRule[]
  orderItems        OrderItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileKey   String
  bucket    String
  fileName  String
  mimeType  String
  fileSize  Int
  position  Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_images")
}

model ProductVariant {
  id                       String                 @id @default(uuid())
  productId                String
  product                  Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                      String                 @unique
  name                     String
  attributesJson           Json?
  price                    Decimal                @db.Decimal(12, 2)
  promotionalPrice         Decimal?               @db.Decimal(12, 2)
  wholesalePrice           Decimal?               @db.Decimal(12, 2)
  minimumWholesaleQuantity Int?
  currencyId               String
  currency                 Currency               @relation(fields: [currencyId], references: [id])
  barcode                  String?
  weight                   Decimal?               @db.Decimal(8, 3)
  status                   ProductVariantStatus   @default(ACTIVE)
  inventoryItems           InventoryItem[]
  cartItems                CartItem[]
  orderItems               OrderItem[]
  stockReservationItems    StockReservationItem[]
  inboundItems             InboundItem[]
  transferItems            TransferItem[]
  warehouseMovements       WarehouseMovement[]
  cycleCountItems          CycleCountItem[]
  pickingItems             PickingItem[]
  packingItems             PackingItem[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?

  @@map("product_variants")
}

model Warehouse {
  id                    String                 @id @default(uuid())
  countryId             String
  country               Country                @relation(fields: [countryId], references: [id])
  sellerId              String?
  seller                SellerProfile?         @relation(fields: [sellerId], references: [id])
  name                  String
  code                  String                 @unique
  type                  WarehouseType          @default(SELLER_WAREHOUSE)
  status                WarehouseStatus        @default(ACTIVE)
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postalCode            String?
  latitude              Decimal?               @db.Decimal(10, 8)
  longitude             Decimal?               @db.Decimal(11, 8)
  capacity              Int                    @default(0)
  usedCapacity          Int                    @default(0)
  timezone              String                 @default("UTC")
  primaryCurrencyId     String?
  primaryCurrency       Currency?              @relation("WarehousePrimaryCurrency", fields: [primaryCurrencyId], references: [id])
  languagesJson         Json?
  operatingHoursJson    Json?
  usedWeight            Decimal                @default(0) @db.Decimal(12, 3)
  maxWeight             Decimal                @default(0) @db.Decimal(12, 3)
  usedVolume            Decimal                @default(0) @db.Decimal(12, 3)
  maxVolume             Decimal                @default(0) @db.Decimal(12, 3)
  managerId             String?
  manager               User?                  @relation("WarehouseManager", fields: [managerId], references: [id])
  inventoryItems        InventoryItem[]
  shippingRateRules     ShippingRateRule[]
  stockReservationItems StockReservationItem[]
  zones                 HubZone[]
  locations             HubLocation[]
  inboundShipments      InboundShipment[]
  originTransfers       TransferOrder[]        @relation("OriginWarehouseTransfers")
  destinationTransfers  TransferOrder[]        @relation("DestinationWarehouseTransfers")
  warehouseMovements    WarehouseMovement[]
  cycleCounts           CycleCount[]
  pickingOrders         PickingOrder[]
  pickingBatches        PickingBatch[]
  packingOrders         PackingOrder[]
  shippingManifests     ShippingManifest[]
  shipments             Shipment[]
  trackingEvents        TrackingEvent[]
  trackingCheckpoints   TrackingCheckpoint[]
  pickupRequests        PickupRequest[]
  deliveryRoutes        DeliveryRoute[]
  returnRequests        ReturnRequest[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  @@map("warehouses")
}

model InventoryItem {
  id                    String                 @id @default(uuid())
  variantId             String
  variant               ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId           String
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId            String?
  location              HubLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quantityAvailable     Int                    @default(0)
  quantityReserved      Int                    @default(0)
  quantityInTransit     Int                    @default(0)
  quantityDamaged       Int                    @default(0)
  reorderPoint          Int                    @default(10)
  movements             InventoryMovement[]
  stockReservationItems StockReservationItem[]
  pickingItems          PickingItem[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([variantId, warehouseId])
  @@map("inventory_items")
}

model InventoryMovement {
  id               String        @id @default(uuid())
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type             MovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  referenceType    String?
  referenceId      String?
  createdById      String?
  createdBy        User?         @relation("MovementCreator", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())

  @@map("inventory_movements")
}

// ==========================================
