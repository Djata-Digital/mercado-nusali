  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentRequirement {
  PREPAYMENT
  POSTPAYMENT
  ESCROW
  NONE
}

enum ShippingCalculationStatus {
  CALCULATED
